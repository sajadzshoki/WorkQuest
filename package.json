{
  "name": "workquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkQuest — Persian-first, multi-tenant employee performance management SaaS with a gamification layer.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port ${PORT:-3000}",
    "build": "prisma generate && nuxt build",
    "generate": "prisma generate && nuxt generate",
    "preview": "nuxt preview --host 0.0.0.0 --port ${PORT:-3000}",
    "start": "node .output/server/index.mjs",
    "postinstall": "prisma generate && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint app server shared test prisma *.config.ts eslint.config.js",
    "lint:fix": "eslint app server shared test prisma *.config.ts eslint.config.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash scripts/run-integration.sh",
    "test:integration:local": "bash scripts/run-integration-local.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:local": "prisma dev",
    "db:local:pglite": "node scripts/local-db.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.128",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "jose": "^6.2.10",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "vue": "^3.5.40",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
