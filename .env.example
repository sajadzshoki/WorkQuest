# =============================================================================
# WorkQuest — environment template
# Copy to `.env` and fill in the values. Never commit real secrets.
#
#   cp .env.example .env
#
# Nuxt runtime config rule: every key below prefixed with NUXT_ maps to a key in
# `runtimeConfig` (nuxt.config.ts). `NUXT_PUBLIC_*` keys are exposed to the
# browser, everything else stays on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Standard connection string used by both the Prisma CLI and the runtime client.
DATABASE_URL="postgresql://workquest:workquest@localhost:5432/workquest?schema=public"
# Optional: separate URL for migrations when using a pooler (PgBouncer/Supabase).
# DIRECT_URL="postgresql://workquest:workquest@localhost:5432/workquest?schema=public"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NUXT_PUBLIC_APP_NAME="ورک‌کوئست"
NUXT_PUBLIC_APP_URL="http://localhost:3000"
NUXT_PUBLIC_DEFAULT_LOCALE="fa"
NUXT_PUBLIC_SUPPORT_EMAIL="support@workquest.local"
# Public origin used when building absolute links (emails, OTP deep links, …).
NUXT_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Sessions (JWT)
# -----------------------------------------------------------------------------
# REQUIRED in every environment. Generate with:  openssl rand -base64 48
# Minimum 32 characters — the server refuses to boot with a weak secret.
NUXT_SESSION_SECRET="change-me-to-a-32+-char-random-secret"
NUXT_SESSION_COOKIE_NAME="workquest_session"
NUXT_SESSION_ISSUER="workquest"
# Access token lifetime in seconds (default: 7 days).
NUXT_SESSION_MAX_AGE_SECONDS="604800"
# Refresh the token when less than this many seconds remain (default: 1 day).
NUXT_SESSION_RENEW_THRESHOLD_SECONDS="86400"
# Send the session cookie with the Secure flag. Must be "true" behind HTTPS.
NUXT_SECURE_COOKIES="true"

# -----------------------------------------------------------------------------
# One-time passwords (login)
# -----------------------------------------------------------------------------
# Supported drivers: "console" (logs the code — development only) and "http"
# (POSTs the code to any SMS gateway). See server/utils/otp/providers.ts.
NUXT_OTP_PROVIDER="console"
NUXT_OTP_CODE_LENGTH="6"
NUXT_OTP_TTL_SECONDS="120"
NUXT_OTP_MAX_ATTEMPTS="5"
NUXT_OTP_RESEND_COOLDOWN_SECONDS="90"

# --- "http" driver: a vendor-agnostic gateway adapter ------------------------
# Leave unset and the driver reports itself as unconfigured instead of silently
# doing nothing. Tokens available in the template: {code} {ttl} {app_name}
# NUXT_OTP_HTTP_URL="https://api.example-sms-gateway.com/v1/send"
# NUXT_OTP_HTTP_API_KEY=""
# NUXT_OTP_HTTP_TEMPLATE="کد ورود شما به {app_name}: {code} — اعتبار {ttl} ثانیه"

# -----------------------------------------------------------------------------
# Development helpers
# -----------------------------------------------------------------------------
# Phone number auto-provisioned as company OWNER by `npm run db:seed`.
NUXT_BOOTSTRAP_ADMIN_PHONE="+989120000001"
# Set to "false" to disable the interactive Nuxt DevTools panel.
NUXT_DEVTOOLS="true"
