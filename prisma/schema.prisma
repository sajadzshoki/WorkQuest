// ---------------------------------------------------------------------------
// WorkQuest domain schema.
//
// Conventions
// -----------
// * Every tenant-owned model carries `companyId` and is listed in
//   `server/utils/tenant.ts` so the tenant-scoped Prisma client can enforce
//   isolation automatically (see `createTenantClient`).
// * Ids are UUIDv7 (`uuid(7)`) so they sort chronologically and shard well.
// * Timestamps are `createdAt` / `updatedAt`; soft state is modelled with
//   explicit status enums rather than deleted flags for now.
// * Counters that drive the gamification loop (XP, coins, streaks) live in
//   `UserProgress`, and every mutation is accompanied by an immutable ledger
//   row (`XpTransaction` / `CoinTransaction`) for auditing.
// ---------------------------------------------------------------------------

generator client {
  provider               = "prisma-client"
  output                 = "./generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

/// Why an OTP was requested. A code issued for registration cannot be replayed
/// to sign in to an existing account, and vice versa.
enum OtpPurpose {
  LOGIN
  REGISTER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TeamRole {
  LEAD
  MEMBER
}

/// Task lifecycle.
///
///   TODO → IN_PROGRESS → SUBMITTED → APPROVED
///                            ↓
///                     NEEDS_REVISION → IN_PROGRESS → SUBMITTED
///
/// The legal edges live in `shared/utils/task.ts` (`TASK_TRANSITIONS`) and are
/// enforced on every mutation, so a client can never post a status directly.
enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  APPROVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// A reviewer either accepts the work or sends it back for revision.
enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum LedgerSource {
  TASK_REVIEW
  ACHIEVEMENT
  CHALLENGE
  STREAK
  RECOGNITION
  REWARD_REDEMPTION
  REFUND
  MANUAL_ADJUSTMENT
}

/// Why a coin transaction exists. Distinct from `LedgerSource` (which the XP
/// ledger uses) because coins are a *currency* with spend semantics, while XP
/// is a permanent progression counter. Keeping the taxonomies separate stops
/// one system's vocabulary leaking into the other.
enum CoinTransactionType {
  TASK_REWARD
  RECOGNITION_REWARD
  ACHIEVEMENT_REWARD
  CHALLENGE_REWARD
  REWARD_REDEMPTION
  ADMIN_ADJUSTMENT
}

enum AchievementType {
  MILESTONE
  STREAK
  SKILL
  TEAM
  SPECIAL
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RewardType {
  PHYSICAL
  VOUCHER
  TIME_OFF
  DONATION
  CUSTOM
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ENDED
  CANCELLED
}

enum ParticipantStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CLAIMED
}

enum RecognitionType {
  PEER
  MANAGER
  COMPANY
  SYSTEM
}

/// How often a recognition cycle turns over. The active cycle's window is
/// derived from this in the company timezone (calendar week / calendar month).
enum RecognitionFrequency {
  WEEKLY
  MONTHLY
}

/// Lifecycle of a cycle. FINALIZED is terminal: results are sealed and rewards
/// have been paid, so a finalized cycle can never be edited or re-run.
enum RecognitionCycleStatus {
  ACTIVE
  FINALIZED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_SUBMITTED
  TASK_REVIEWED
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  REWARD_AVAILABLE
  REDEMPTION_UPDATE
  RECOGNITION_RECEIVED
  CHALLENGE_UPDATE
  INVITATION
  TEAM_UPDATE
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A tenant. Every other resource in the system belongs to exactly one company.
model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?
  industry  String?
  /// Default locale for the tenant's UI and digests.
  locale    String   @default("fa")
  /// IANA timezone used for streaks, digests and due-date math.
  timezone  String   @default("Asia/Tehran")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  teams         Team[]
  teamMembers   TeamMember[]
  levels        Level[]
  userProgress  UserProgress[]
  xpLedger      XpTransaction[]
  coinLedger    CoinTransaction[]
  wallets       Wallet[]
  rewardRules   RewardRule[]
  tasks         Task[]
  taskReviews   TaskReview[]
  taskComments  TaskComment[]
  taskAttachments TaskAttachment[]
  taskEvents    TaskEvent[]
  achievements  Achievement[]
  userAchievements UserAchievement[]
  badges        Badge[]
  userBadges    UserBadge[]
  recognitions  Recognition[]
  recognitionCycles      RecognitionCycle[]
  recognitionCategories  RecognitionCategory[]
  recognitionVotes       RecognitionVote[]
  recognitionResults     RecognitionResult[]
  recognitionTitles      RecognitionTitle[]
  rewards       Reward[]
  redemptions   RewardRedemption[]
  challenges    Challenge[]
  participants  ChallengeParticipant[]
  notifications Notification[]
  auditLogs     AuditLog[]
  invitations   Invitation[]
}

/// A person inside a company. One user row == one company membership.
/// (Cross-company membership would be introduced as a `Membership` join model.)
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  companyId    String     @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String?
  /// Iranian mobile number in E.164 form, e.g. +989121234567 — the primary login handle.
  phone        String?
  fullName     String
  avatarUrl    String?
  jobTitle     String?
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  locale       String     @default("fa")
  timezone     String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  progress        UserProgress?
  teamMemberships TeamMember[]
  managedTeams    TeamMember[]       @relation("TeamMemberManager")
  ownedTeams      Team[]
  assignedTasks   Task[]             @relation("TaskAssignee")
  createdTasks    Task[]             @relation("TaskAssigner")
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]
  taskEvents      TaskEvent[]
  reviews         TaskReview[]
  achievements    UserAchievement[]
  badges          UserBadge[]
  xpLedger        XpTransaction[]
  coinLedger      CoinTransaction[]
  wallet          Wallet?
  recognitionsGiven  Recognition[]   @relation("RecognitionFrom")
  recognitionsReceived Recognition[] @relation("RecognitionTo")
  recognitionVotesCast     RecognitionVote[]   @relation("RecognitionVoter")
  recognitionVotesReceived RecognitionVote[]   @relation("RecognitionNominee")
  recognitionWins          RecognitionResult[] @relation("RecognitionWinner")
  redemptions     RewardRedemption[]
  participations  ChallengeParticipant[]
  notifications   Notification[]
  sessions        Session[]
  auditLogs       AuditLog[]
  invitationsSent     Invitation[] @relation("InvitationInviter")
  invitationsAccepted Invitation[] @relation("InvitationAccepted")

  @@unique([companyId, email])
  @@unique([companyId, phone])
  /// Login resolves an account from the phone number across companies, so the
  /// composite unique index above cannot serve that lookup.
  @@index([phone])
  @@index([companyId, role])
  @@index([companyId, status])
}

/// Short-lived, pre-authentication one-time password. Deliberately not tenant-scoped:
/// the company is resolved only after the phone number is verified.
model OtpCode {
  id           String    @id @default(uuid(7)) @db.Uuid
  phone        String
  purpose      OtpPurpose @default(LOGIN)
  /// scrypt digest — the plaintext code is never stored.
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  consumedAt   DateTime?
  requestIp    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  /// Lookup used by verification: newest unconsumed code for a phone+purpose.
  @@index([phone, purpose, createdAt])
  /// Housekeeping / abuse review: find codes that expired unused.
  @@index([expiresAt])
}

///
/// Single-use authorisation to finish self-service registration.
///
/// Issued after a phone number is OTP-verified but no account exists yet. It
/// lives in an httpOnly cookie (the browser never sees the id) and is backed by
/// this row so it can be revoked and is genuinely single-use — a stateless
/// ticket could otherwise create unlimited companies within its TTL.
///
model OnboardingTicket {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([phone, consumedAt])
  @@index([expiresAt])
}

/// Server-side session record. The cookie holds a signed JWT carrying `sid`,
/// which makes sessions revocable without giving up stateless verification.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// ---------------------------------------------------------------------------
// Structure
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  leadId      String?  @db.Uuid
  lead        User?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  tasks       Task[]
  invitations Invitation[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model TeamMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId    String    @db.Uuid
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Direct manager for this membership — the edge used for manager-scoped access.
  managerId String?   @db.Uuid
  manager   User?     @relation("TeamMemberManager", fields: [managerId], references: [id], onDelete: SetNull)
  role      TeamRole  @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([teamId, userId])
  /// One primary team per employee: a second membership in the same company is
  /// a data error, not a feature.
  @@unique([companyId, userId])
  @@index([companyId, userId])
  @@index([companyId, managerId])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

/// Level ladder for a tenant. `minXp` is the inclusive lower bound of the level.
model Level {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  level     Int
  minXp     Int
  /// Human friendly Persian title, e.g. «کاوشگر» or «راهبر».
  title     String?
  iconKey   String?

  @@unique([companyId, level])
  @@index([companyId, minXp])
}

/// Denormalised counters for a user. Mutations must always be paired with a
/// ledger row so the numbers stay explainable.
///
/// A pending employee invitation.
///
/// Invitations are deliberately **not** `User` rows: the invitee has no account
/// yet, may be invited by several companies at once, and the invitation must be
/// revocable and expirable without touching the user table. Accepting one is
/// what creates the `User`.
///
/// `pendingPhone` carries the phone only while the invitation is open, and is
/// nulled when it is accepted/revoked/expired. PostgreSQL treats NULLs as
/// distinct in unique indexes, so this enforces "at most one open invitation per
/// company + phone" while keeping the full history of closed ones.
///
model Invitation {
  id           String           @id @default(uuid(7)) @db.Uuid
  companyId    String           @db.Uuid
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phone        String
  /// Set while PENDING, cleared afterwards — see the note above.
  pendingPhone String?
  fullName     String
  jobTitle     String?
  teamId       String?          @db.Uuid
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  /// The role the invitee receives on acceptance. Never client-controlled for
  /// anyone below ADMIN.
  role         UserRole         @default(EMPLOYEE)
  status       InvitationStatus @default(PENDING)
  invitedById  String           @db.Uuid
  invitedBy    User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  /// The user created when the invitation was accepted.
  acceptedById String?          @db.Uuid
  acceptedBy   User?            @relation("InvitationAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@unique([companyId, pendingPhone])
  @@index([companyId, status])
  @@index([phone, status])
  @@index([expiresAt])
}

model UserProgress {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @db.Uuid
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String    @unique @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp             Int       @default(0)
  coins          Int       @default(0)
  levelId        String?   @db.Uuid
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  /// Calendar date (in the user's timezone) of the last activity that fed the streak.
  lastActiveDate DateTime? @db.Date
  updatedAt      DateTime  @updatedAt

  @@index([companyId, xp])
}

/// Immutable XP ledger.
model XpTransaction {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  source        LedgerSource
  reason        String?
  referenceType String?
  referenceId   String?      @db.Uuid
  /// See `CoinTransaction.idempotencyKey`.
  idempotencyKey String?     @db.VarChar(200)
  createdAt     DateTime     @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, userId, createdAt])
  @@index([companyId, source])
}

/// Immutable coin ledger. Append-only: corrections are new rows, never edits.
model CoinTransaction {
  id            String              @id @default(uuid(7)) @db.Uuid
  companyId     String              @db.Uuid
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String              @db.Uuid
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId      String?             @db.Uuid
  wallet        Wallet?             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// Signed: positive credits, negative debits.
  amount        Int
  type          CoinTransactionType @default(ADMIN_ADJUSTMENT)
  source        LedgerSource
  reason        String?
  referenceType String?
  referenceId   String?             @db.Uuid
  /// Wallet balance immediately after this row was applied, so a statement can
  /// be rendered without re-summing the whole ledger.
  balanceAfter  Int?
  /// Natural key for at-most-once processing, e.g. `task:<id>:reward`. The
  /// unique index — not application logic — is what makes payouts idempotent.
  idempotencyKey String?            @db.VarChar(200)
  createdAt     DateTime            @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, userId, createdAt])
  @@index([companyId, source])
  @@index([companyId, type, createdAt])
  @@index([walletId, createdAt])
}

model Achievement {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Stable machine key, e.g. `first_approved_task`.
  key         String
  title       String
  description String?
  type        AchievementType @default(MILESTONE)
  /// Declarative rule evaluated by the Phase 1 rule engine.
  criteria    Json            @default("{}")
  xpReward    Int             @default(0)
  coinReward  Int             @default(0)
  iconKey     String?
  status      CatalogStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  unlocks UserAchievement[]
  badges  Badge[]

  @@unique([companyId, key])
  @@index([companyId, status])
}

model UserAchievement {
  id            String      @id @default(uuid(7)) @db.Uuid
  companyId     String      @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Json        @default("{}")
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([companyId, userId])
}

model Badge {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyId     String        @db.Uuid
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  imageUrl      String?
  /// Iconify icon name, e.g. `i-heroicons-flag`. Falls back to a shield glyph.
  iconKey       String?
  /// Semantic rendering tone: `primary`, `coin`, `streak`, `success`, `info`,
  /// `warning` or `neutral`. Read by the reusable badge components.
  tone          String?
  achievementId String?       @db.Uuid
  achievement   Achievement?  @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  holders    UserBadge[]
  categories RecognitionCategory[]

  @@index([companyId])
}

model UserBadge {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String   @db.Uuid
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([companyId, userId])
}

/// Kudos sent between colleagues.
model Recognition {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromUserId  String          @db.Uuid
  fromUser    User            @relation("RecognitionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String          @db.Uuid
  toUser      User            @relation("RecognitionTo", fields: [toUserId], references: [id], onDelete: Cascade)
  taskId      String?         @db.Uuid
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type        RecognitionType @default(PEER)
  message     String
  xpAwarded   Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([companyId, toUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Recognition cycles
// ---------------------------------------------------------------------------

/// The recurring voting period. At most one cycle is ACTIVE at a time; the
/// window (a calendar week or month in the company timezone) is sealed onto the
/// row, so history stays truthful even if the cadence changes later.
model RecognitionCycle {
  id          String                 @id @default(uuid(7)) @db.Uuid
  companyId   String                 @db.Uuid
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  frequency   RecognitionFrequency
  status      RecognitionCycleStatus @default(ACTIVE)
  title       String?
  startsAt    DateTime
  endsAt      DateTime
  finalizedAt DateTime?
  createdBy   String?                @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  votes   RecognitionVote[]
  results RecognitionResult[]

  @@unique([companyId, frequency, startsAt])
  @@index([companyId, status])
  @@index([companyId, endsAt])
}

/// A bucket people vote in — «مسئول‌ترین همکار», «بهترین هم‌تیمی», … It carries
/// the *reward* the winner earns (XP, coins, optional badge) and the *title*
/// the winner is given, so an admin configures everything in one place.
model RecognitionCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Iconify icon name for the card, e.g. `i-heroicons-shield-check`.
  iconKey     String?
  /// Semantic tone: `primary`, `coin`, `streak`, `success`, `info`, `warning`, `neutral`.
  tone        String?   @default("primary")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  xpReward    Int       @default(0)
  coinReward  Int       @default(0)
  titleId     String?   @db.Uuid
  title       RecognitionTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)
  badgeId     String?   @db.Uuid
  badge       Badge?    @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  votes   RecognitionVote[]
  results RecognitionResult[]

  @@index([companyId, isActive])
  @@index([companyId, sortOrder])
}

/// One employee's choice in one category of one cycle. At most one vote per
/// (cycle, category, voter) — the unique index is the duplicate-vote guard.
model RecognitionVote {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycleId    String   @db.Uuid
  cycle      RecognitionCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   RecognitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  voterId    String   @db.Uuid
  voter      User     @relation("RecognitionVoter", fields: [voterId], references: [id], onDelete: Cascade)
  nomineeId  String   @db.Uuid
  nominee    User     @relation("RecognitionNominee", fields: [nomineeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([cycleId, categoryId, voterId])
  @@index([cycleId, nomineeId])
  @@index([companyId, voterId, createdAt])
}

/// The sealed outcome of one category of one cycle: who won, by how much, and
/// what they were paid. Vote *details* stay in `RecognitionVote` and are never
/// exposed to the API — results are aggregated by design.
model RecognitionResult {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycleId    String    @db.Uuid
  cycle      RecognitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  categoryId String    @db.Uuid
  category   RecognitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  winnerId   String    @db.Uuid
  winner     User      @relation("RecognitionWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  voteCount  Int       @default(0)
  /// Title snapshot: denormalised so a later rename never rewrites history.
  titleId    String?   @db.Uuid
  title      RecognitionTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)
  titleName  String?
  xpReward   Int       @default(0)
  coinReward Int       @default(0)
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([cycleId, categoryId])
  @@index([companyId, winnerId, createdAt])
}

/// A title a winner is given — system-defined (seeded) or admin-created.
model RecognitionTitle {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  categories RecognitionCategory[]
  results    RecognitionResult[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Work
// ---------------------------------------------------------------------------

/// A user's coin balance.
///
/// The balance is a **cache of the ledger**, never an independent truth: every
/// write goes through `applyCoinDelta`, which appends a `CoinTransaction` and
/// moves `balance` in the same transaction. `lifetimeEarned`/`lifetimeSpent`
/// are kept alongside so "you have earned 4,200 coins in total" does not need
/// a full ledger scan on every page load.
model Wallet {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String   @unique @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  lifetimeSpent  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions CoinTransaction[]

  @@index([companyId, balance])
}

/// Per-company, versioned reward economy.
///
/// The whole point of this table is that the economy is *data*, not code: an
/// admin can retune payouts without a deploy, and — because rules are
/// versioned rather than mutated — a payout made last month can still be
/// explained by the rule set that produced it. Exactly one row per company is
/// `isActive`.
model RewardRule {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  version   Int
  isActive  Boolean @default(false)

  /// Baseline payout for a task with no priority weighting, before multipliers.
  baseXp    Int @default(100)
  baseCoins Int @default(50)

  /// Priority multipliers, in basis points (10000 = 1.0x).
  lowPriorityBp    Int @default(8000)
  mediumPriorityBp Int @default(10000)
  highPriorityBp   Int @default(13000)

  /// Score-band multipliers, in basis points. Bands are 90-100 / 80-89 /
  /// 70-79 / below 70.
  excellentBp Int @default(10000)
  goodBp      Int @default(8000)
  fairBp      Int @default(6000)
  poorBp      Int @default(3000)

  /// Additive bonuses, in basis points of the post-band amount.
  onTimeBonusBp     Int @default(1000)
  earlyBonusBp      Int @default(2000)
  highQualityBonusBp Int @default(1500)

  /// Additive penalties, in basis points. `revisionPenaltyBp` is charged per
  /// revision round, capped by `maxRevisionPenaltyBp`.
  overduePenaltyBp     Int @default(2500)
  revisionPenaltyBp    Int @default(1000)
  maxRevisionPenaltyBp Int @default(5000)

  /// Floor/ceiling on the final multiplier so no combination of rules can pay
  /// a negative amount or an unbounded jackpot.
  minMultiplierBp Int @default(0)
  maxMultiplierBp Int @default(20000)

  /// How many days before the due date counts as "early".
  earlyDays Int @default(1)
  /// Quality (1-5) at or above which the high-quality bonus applies.
  highQualityThreshold Int @default(5)

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  @@unique([companyId, version])
  @@index([companyId, isActive])
}

/// A unit of work. The lifecycle is `TODO → IN_PROGRESS → SUBMITTED →
/// APPROVED`, with `SUBMITTED → NEEDS_REVISION → IN_PROGRESS` as the rework
/// loop. Status is never written directly by a client: every change goes
/// through a transition endpoint that validates the edge and the actor's role.
model Task {
  id           String       @id @default(uuid(7)) @db.Uuid
  companyId    String       @db.Uuid
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  teamId       String?      @db.Uuid
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assigneeId   String?      @db.Uuid
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignerId   String?      @db.Uuid
  assigner     User?        @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: SetNull)
  xpReward     Int          @default(0)
  coinReward   Int          @default(0)
  /// Planned effort in hours, as estimated by the manager at creation time.
  estimatedHours Decimal?   @db.Decimal(6, 2)
  /// Self-reported completion, 0-100. Employees move it while working.
  progress     Int          @default(0)
  dueDate      DateTime?
  assignedAt   DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  completedAt  DateTime?
  /// How many times the task has come back from review. Drives the
  /// "needs attention" surfaces on the manager dashboard.
  revisionCount Int         @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reviews      TaskReview[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  events       TaskEvent[]
  recognitions Recognition[]

  @@index([companyId, status])
  @@index([companyId, assigneeId, status])
  @@index([companyId, teamId, status])
  @@index([companyId, dueDate])
  @@index([companyId, status, dueDate])
  @@index([companyId, assigneeId, dueDate])
  @@index([companyId, priority, dueDate])
}

/// Discussion thread on a task. Visible to the assignee, the assigner and
/// anyone who can review the task.
model TaskComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, taskId, createdAt])
  @@index([companyId, authorId])
}

/// A file linked to a task. Storage is out of scope for this phase, so the row
/// records a URL plus its metadata — an uploader can be swapped in later
/// without touching the task endpoints.
model TaskAttachment {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId      String   @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String  @db.Uuid
  uploadedBy  User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  @@index([companyId, taskId, createdAt])
}

/// Append-only lifecycle trail: who moved the task, from what, to what.
/// Kept separate from `AuditLog` because it is user-facing (the activity feed
/// on the task page) rather than a security record.
model TaskEvent {
  id        String      @id @default(uuid(7)) @db.Uuid
  companyId String      @db.Uuid
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String      @db.Uuid
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?     @db.Uuid
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Machine key, e.g. `task.created`, `task.started`, `task.approved`.
  action    String
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  note      String?
  createdAt DateTime    @default(now())

  @@index([companyId, taskId, createdAt])
}

model TaskReview {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @db.Uuid
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId        String         @db.Uuid
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewerId    String         @db.Uuid
  reviewer      User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  decision      ReviewDecision
  /// 0-100 overall score driving XP/coin awards. Null when the reviewer sent
  /// the task back without grading it.
  score         Int?
  /// Reviewer's 1-5 sub-scores. Quality feeds the high-quality bonus;
  /// timeliness is recorded for reporting but on-time payout math uses the
  /// actual timestamps, not the reviewer's opinion of them.
  qualityScore     Int?
  timelinessScore  Int?
  feedback      String?
  xpAwarded     Int            @default(0)
  coinsAwarded  Int            @default(0)
  /// Frozen `RewardBreakdown` (inputs, multipliers and rule version) as it was
  /// at payout time. Rules are versioned, but storing the computation makes a
  /// past payout explainable without replaying anything.
  rewardBreakdown Json?
  createdAt     DateTime       @default(now())

  @@index([companyId, taskId])
  @@index([companyId, reviewerId, createdAt])
}

// ---------------------------------------------------------------------------
// Rewards & challenges
// ---------------------------------------------------------------------------

model Reward {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyId   String        @db.Uuid
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        RewardType    @default(CUSTOM)
  cost        Int
  stock       Int?
  imageUrl    String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  redemptions RewardRedemption[]

  @@index([companyId, status])
}

model RewardRedemption {
  id         String           @id @default(uuid(7)) @db.Uuid
  companyId  String           @db.Uuid
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rewardId   String           @db.Uuid
  reward     Reward           @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     RedemptionStatus @default(REQUESTED)
  cost       Int
  note       String?
  decidedBy  String?
  decidedAt  DateTime?
  requestedAt DateTime        @default(now())

  @@index([companyId, userId, status])
  @@index([companyId, status])
}

model Challenge {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Machine key of the tracked metric, e.g. `tasks_approved`.
  goalKey     String
  goalValue   Int             @default(1)
  xpReward    Int             @default(0)
  coinReward  Int             @default(0)
  startsAt    DateTime
  endsAt      DateTime
  status      ChallengeStatus @default(DRAFT)
  badgeId     String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  participants ChallengeParticipant[]

  @@index([companyId, status])
}

model ChallengeParticipant {
  id          String            @id @default(uuid(7)) @db.Uuid
  companyId   String            @db.Uuid
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  challengeId String            @db.Uuid
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Int               @default(0)
  status      ParticipantStatus @default(NOT_STARTED)
  completedAt DateTime?
  joinedAt    DateTime          @default(now())

  @@unique([challengeId, userId])
  @@index([companyId, userId])
}

// ---------------------------------------------------------------------------
// Messaging & audit
// ---------------------------------------------------------------------------

model Notification {
  id        String             @id @default(uuid(7)) @db.Uuid
  companyId String             @db.Uuid
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  data      Json               @default("{}")
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([companyId, userId, status])
  @@index([companyId, userId, createdAt])
}

/// Append-only audit trail for security-relevant and gamification events.
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId      String?  @db.Uuid
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  targetType   String?
  targetId     String?
  data         Json     @default("{}")
  ip           String?
  createdAt    DateTime @default(now())

  @@index([companyId, action, createdAt])
  @@index([companyId, actorId])
}
